In Web API, a controller action returns data — not a page. ASP.NET Core serializes your C# objects into JSON automatically and sends 
it with the correct HTTP status code. The client (browser SPA, mobile app, another service) handles the rendering.
-----------------------------------------------------------------------------------------------------------------------
[ApiController]                        // ← enables API-specific behaviors
[Route("api/[controller]")]
public class ProductsController : ControllerBase  // ← ControllerBase (no View support)
{
    private readonly AppDbContext _context;
 
    public ProductsController(AppDbContext context) => _context = context;
 
    [HttpGet]                           // GET api/products
    public async Task<ActionResult<IEnumerable<Product>>> GetAll()
    {
        return Ok(await _context.Products.ToListAsync());  // 200 + JSON array
    }
 
    [HttpGet("{id}")]                    // GET api/products/5
    public async Task<ActionResult<Product>> GetById(int id)
    {
        var product = await _context.Products.FindAsync(id);
        if (product == null) return NotFound();      // 404
        return Ok(product);                          // 200 + JSON object
    }
}
---------------------------------------------------------------------------------------------------------------------------
// ControllerBase — the shared foundation
public abstract class ControllerBase
{
    // Routing, ModelState, HttpContext, Request, Response
    // Ok(), NotFound(), BadRequest(), Created(), StatusCode()
    // [FromBody], [FromQuery], [FromRoute] model binding
}
 
// Controller — adds View support on top
public abstract class Controller : ControllerBase
{
    // Everything from ControllerBase PLUS:
    // View(), PartialView(), ViewComponent()
    // ViewBag, ViewData, TempData
    // RedirectToAction(), Json(), Content()
}
