In MVC, a controller action returns a ViewResult — EF Core fetches data, the controller passes it to a Razor view
(.cshtml), and the server renders a complete HTML page sent to the browser.
-------------------------------------------------------------------------------------------------------------------
public class ProductsController : Controller   // ← Controller (not ControllerBase)
{
    private readonly AppDbContext _context;
 
    public ProductsController(AppDbContext context) => _context = context;
 
    // Returns an HTML page — not JSON
    public async Task<IActionResult> Index()
    {
        var products = await _context.Products.ToListAsync();
        return View(products);   // renders Views/Products/Index.cshtml
    }
 
    // Passes a single item to a detail page
    public async Task<IActionResult> Details(int id)
    {
        var product = await _context.Products.FindAsync(id);
        if (product == null) return NotFound();
        return View(product);   // renders Views/Products/Details.cshtml
    }
}
-----------------------------------------------------------------------------------------------------------------------
The Razor View — Index.cshtml
-----------------------------
@* Strongly typed view — model is a list of Products *@
@model IEnumerable<Product>
 
<h1>All Products</h1>
<ul>
@foreach (var p in Model)
{
    <li>@p.Name — @p.Price.ToString("C")</li>
}
</ul>
