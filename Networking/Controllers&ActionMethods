A controller is a class that groups related HTTP endpoints together. Each action method inside it handles one 
specific request — reading input, calling services, and returning a response. Controllers are the bridge between
the HTTP pipeline and your application logic.
-----------------------------------------------------------------------------------------------------------------------
ControllerBase vs Controller
----------------------------
// Side-by-Side — Same Action, Different Base Class
// ✅ Web API controller — ControllerBase, returns JSON
[ApiController]
[Route("api/[controller]")]
public class ProductsController : ControllerBase
{
    [HttpGet]
    public ActionResult<IEnumerable<Product>> GetAll()
        => Ok(_products);   // returns 200 + JSON
}

// ✅ MVC controller — Controller, renders .cshtml views
public class ProductsController : Controller
{
    public IActionResult Index()
        => View(_products);  // renders Views/Products/Index.cshtml
}

// ❌ Wrong — API controller inheriting Controller
public class ProductsController : Controller   // ← loads Razor engine unnecessarily
{
    [HttpGet]
    public IActionResult GetAll() => Ok(_products);
    // Never calls View() — Controller base is wasted overhead
}
