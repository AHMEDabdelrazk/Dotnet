Calling Stored Procedures
**************************
Stored Procedure That Returns Entities
**************************************
// Stored procedure: GetProductsByCategory
var categoryId = 1;
var products = context.Products
    .FromSql(
        $"EXEC GetProductsByCategory {categoryId}")
    .ToList();
---------------------------------------------------------------
Non-Query Stored Procedure
**************************
// For INSERT/UPDATE/DELETE stored procedures
var productId = 1;
var newPrice = 199.99m;

var rowsAffected = await context.Database
    .ExecuteSqlAsync(
        $"EXEC UpdateProductPrice {productId}, {newPrice}");

Console.WriteLine($"{rowsAffected} rows updated");
----------------------------------------------------------------
Output Parameters
*****************
var outputParam = new SqlParameter("@TotalCount", SqlDbType.Int)
{
    Direction = ParameterDirection.Output
};

await context.Database.ExecuteSqlRawAsync(
    "EXEC GetProductCount @TotalCount OUTPUT", outputParam);

var count = (int)outputParam.Value;
