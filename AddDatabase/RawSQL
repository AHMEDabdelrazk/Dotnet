
When to Use Raw SQL
  *Complex queries that LINQ can't express efficiently
  *Database-specific features (CTEs, window functions)
  *Calling stored procedures
  *Performance-critical queries (hand-tuned SQL)
  *Legacy database with existing procedures

----------------------------------------------------------------------------------------------------------
// Simple raw SQL query
var products = context.Products
    .FromSqlRaw("SELECT * FROM Products WHERE Price > 100")
    .ToList();

// Can combine with LINQ!
var products = context.Products
    .FromSqlRaw("SELECT * FROM Products")
    .Where(p => p.IsActive)       // LINQ added to raw SQL
    .OrderBy(p => p.Name)
    .ToList();
-----------------------------------------------------------------------------------------------------------
With Parameters (SAFE!)
***********************
// ✅ Safe — parameterized (prevents SQL injection)
var minPrice = 100m;
var products = context.Products
    .FromSqlRaw("SELECT * FROM Products WHERE Price > {0}", minPrice)
    .ToList();

// Or with SqlParameter
var param = new SqlParameter("@price", minPrice);
var products = context.Products
    .FromSqlRaw("SELECT * FROM Products WHERE Price > @price", param)
    .ToList();
